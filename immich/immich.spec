# Disable debuginfo, since we package some stripped upstream binaries
%global debug_package %{nil}

Name:           immich
Version:        2.7.5
Release:        7%{?dist}
Summary:        Self-hosted photo and video management solution

# Bundled GoogleSans and GoogleSansCode web fonts are OFL-1.1
License:        AGPL-3.0 AND OFL-1.1
URL:            https://immich.app/
# Generated by running ./generate_tarball.sh %%{version}
Source0:        v%{version}.tar.xz

# Service files
Source1: sysusers
Source2: systemd.service
Source3: environment

# Geodata
Source10: https://download.geonames.org/export/dump/cities500.zip
Source11: https://download.geonames.org/export/dump/admin1CodesASCII.txt
Source12: https://download.geonames.org/export/dump/admin2Codes.txt
Source13: https://raw.githubusercontent.com/nvkelso/natural-earth-vector/v5.1.2/geojson/ne_10m_admin_0_countries.geojson

# Fix some hardcoded assumptions about PATH contents
Patch: 0001-more-robust-scripts.patch

ExclusiveArch: %{nodejs_arches}

%if 0%{?fedora} >= 44
Requires: nodejs24-bin
# Fedora's node is built with small-icu, which crashes on Intl.Segmenter
Requires: nodejs24-full-i18n
%else
Requires: nodejs22
# Fedora's node is built with small-icu, which crashes on Intl.Segmenter
Requires: nodejs22-full-i18n
%endif
Requires: python3-immich_ml+cpu = %{version}
Requires: valkey
Requires: VectorChord

# Immich uses ffmpeg and ffprobe executables for transcoding
# We'll get the Fedora version by default, but RPMFusion version
# is also acceptible
Requires: (ffmpeg-free or ffmpeg)

# Immich prefers mimalloc by adding it to LD_PRELOAD
Requires: mimalloc

# Explicitly require vips plug-ins for image format support
Requires: vips-heif
Requires: vips-jxl
Requires: vips-magick

BuildRequires: gcc-c++
BuildRequires: pnpm
BuildRequires: binaryen
BuildRequires: wget
%if 0%{?fedora} >= 44
BuildRequires: nodejs24-bin
BuildRequires: nodejs24-npm-bin
BuildRequires: nodejs24-devel
BuildRequires: nodejs24-full-i18n
%else
BuildRequires: nodejs22
BuildRequires: nodejs22-npm
BuildRequires: nodejs22-devel
BuildRequires: nodejs22-full-i18n
%endif
BuildRequires: python3-devel
BuildRequires: vips-devel
BuildRequires: systemd-rpm-macros

# Web fonts are not packaged in Fedora
Provides: bundled(font(googlesans))
Provides: bundled(font(googlesanscode))

%global _description %{expand:
Easily back up, organize, and manage your photos on your own server. Immich
helps you browse, search and organize your photos and videos with ease,
without sacrificing your privacy.}

%description %_description

%prep
%autosetup -p1 -n %{name}-%{version}

%if 0%{?fedora} >= 46
sed -i -e '/^lib_path=/s|".*"|"%{_libdir}/libmimalloc.so.3"|' server/bin/start.sh
%else
sed -i -e '/^lib_path=/s|".*"|"%{_libdir}/libmimalloc.so.2"|' server/bin/start.sh
%endif

%build
# These build steps essentially mirror those performed in the Dockerfile
export CI=1
export npm_config_manage_package_manager_versions=false

# Build server component
SHARP_IGNORE_GLOBAL_LIBVIPS=true pnpm --filter immich --frozen-lockfile build
SHARP_FORCE_GLOBAL_LIBVIPS=true pnpm --filter immich --frozen-lockfile --prod --no-optional deploy %{_builddir}/server-pruned

# Remove left-overs from the build of sharp binaries
mv %{_builddir}/server-pruned/node_modules/.pnpm/sharp@0.34.5/node_modules/sharp/src/build/Release/sharp-linux-*.node .
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/sharp@0.34.5/node_modules/sharp/src/build
mkdir -p %{_builddir}/server-pruned/node_modules/.pnpm/sharp@0.34.5/node_modules/sharp/src/build/Release
mv sharp-linux-*.node %{_builddir}/server-pruned/node_modules/.pnpm/sharp@0.34.5/node_modules/sharp/src/build/Release

# Remove tools only used to build sharp and bcrypt binaries, not needed at runtime
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/node-gyp@*
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/node-addon-api@*
find %{_builddir}/server-pruned/node_modules -type l \( -name node-gyp -o -name node-addon-api \) -delete
find %{_builddir}/server-pruned/node_modules -path '*/.bin/node-gyp' -delete

# Remove pre-built bcrypt binaries for other platforms and libc variants
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/bcrypt*/node_modules/bcrypt/prebuilds/linux-arm
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/bcrypt*/node_modules/bcrypt/prebuilds/linux*/bcrypt.musl.node
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/bcrypt*/node_modules/bcrypt/prebuilds/darwin*
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/bcrypt*/node_modules/bcrypt/prebuilds/win32*
%ifnarch aarch64
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/bcrypt*/node_modules/bcrypt/prebuilds/linux-arm64
%endif
%ifnarch x86_64
rm -r %{_builddir}/server-pruned/node_modules/.pnpm/bcrypt*/node_modules/bcrypt/prebuilds/linux-x64
%endif

# Remove modules for the Bare JS runtime -- I'm pretty sure immich never
# loads these, and they contain unwanted pre-built natives
find %{_builddir}/server-pruned/node_modules/.pnpm -depth -name 'bare-*' -exec rm -rf {} +

# Remove source maps for third party modules
find %{_builddir}/server-pruned/node_modules -name '*.map' -delete

# Web fonts are removed from the source tarball due to their size, so fetch
# them from upstream Google Fonts repository
GF_COMMIT=b7c8331cf620346575487ef8db0e2c729f014675
wget -O web/src/lib/assets/fonts/GoogleSans/GoogleSans.ttf \
  "https://raw.githubusercontent.com/google/fonts/$GF_COMMIT/ofl/googlesans/GoogleSans%5BGRAD%2Copsz%2Cwght%5D.ttf"
wget -O web/src/lib/assets/fonts/GoogleSansCode/GoogleSansCode.ttf \
  "https://raw.githubusercontent.com/google/fonts/$GF_COMMIT/ofl/googlesanscode/GoogleSansCode%5Bwght%5D.ttf"

# Build web component
SHARP_IGNORE_GLOBAL_LIBVIPS=true pnpm --filter @immich/sdk --filter immich-web --frozen-lockfile --force install
pnpm --filter @immich/sdk --filter immich-web build

# Build CLI component
pnpm --filter @immich/sdk --filter @immich/cli --frozen-lockfile install
pnpm --filter @immich/sdk --filter @immich/cli build
pnpm --filter @immich/cli --prod --no-optional deploy %{_builddir}/cli-pruned

# Plugin component build requires extism-js to be on the path, but it's
# not in Fedora, so extract it from upstream release artifacts
mkdir -p %{_builddir}/extism-bin
%ifarch x86_64
wget -O extism-js.gz https://github.com/extism/js-pdk/releases/download/v1.6.0/extism-js-x86_64-linux-v1.6.0.gz
%endif
%ifarch aarch64
wget -O extism-js.gz https://github.com/extism/js-pdk/releases/download/v1.6.0/extism-js-aarch64-linux-v1.6.0.gz
%endif
gzip -dc extism-js.gz > %{_builddir}/extism-bin/extism-js
chmod +x %{_builddir}/extism-bin/extism-js
export PATH=%{_builddir}/extism-bin:$PATH

# Build core plugin component
pnpm --filter plugins --frozen-lockfile install
pnpm --filter plugins build

%install
# User/Group configuration
install -Dpm 0644 %{SOURCE1} %{buildroot}%{_sysusersdir}/%{name}.conf
# Systemd unit configuration
install -Dpm 0644 %{SOURCE2} %{buildroot}%{_unitdir}/%{name}.service
install -Dpm 0644 %{SOURCE3} %{buildroot}%{_sysconfdir}/sysconfig/%{name}

# Install server component
install -m 0755 -d %{buildroot}%{_prefix}/lib/immich/app/server
cp -pr %{_builddir}/server-pruned/* %{buildroot}%{_prefix}/lib/immich/app/server

# Install command line client
install -m 0755 -d %{buildroot}%{_prefix}/lib/immich/app/cli
cp -pr %{_builddir}/cli-pruned/* %{buildroot}%{_prefix}/lib/immich/app/cli
#install -Dpm 0755 immich-cli/bin/%{name} %{buildroot}%{_bindir}/%{name}

# Install core plugin component
install -Dpm 0644 plugins/manifest.json %{buildroot}%{_prefix}/lib/immich/corePlugin/manifest.json
install -Dpm 0644 plugins/dist/plugin.wasm %{buildroot}%{_prefix}/lib/immich/corePlugin/dist/plugin.wasm

# Install web component
install -m 0755 -d %{buildroot}%{_prefix}/lib/immich/www
cp -pr web/build/* %{buildroot}%{_prefix}/lib/immich/www

# Install geodata
install -m 0755 -d %{buildroot}%{_prefix}/lib/immich/geodata
unzip %{SOURCE10}
install -Dpm 0444 cities500.txt %{buildroot}%{_prefix}/lib/immich/geodata
install -Dpm 0444 %{SOURCE11} %{buildroot}%{_prefix}/lib/immich/geodata
install -Dpm 0444 %{SOURCE12} %{buildroot}%{_prefix}/lib/immich/geodata
install -Dpm 0444 %{SOURCE13} %{buildroot}%{_prefix}/lib/immich/geodata
date --iso-8601=seconds | tr -d "\n" > geodata-date.txt
install -Dpm 0444 geodata-date.txt %{buildroot}%{_prefix}/lib/immich/geodata

# User data directory
install -d %{buildroot}%{_sharedstatedir}/immich

%check
export CI=1
export npm_config_manage_package_manager_versions=false

(cd server && pnpm test)
(cd cli && pnpm test)

%post
%systemd_post %{name}.service

%preun
%systemd_preun %{name}.service

%postun
%systemd_postun_with_restart %{name}.service

%files
%license LICENSE
%doc README.md SECURITY.md
%{_sysusersdir}/%{name}.conf
%{_unitdir}/%{name}.service
%config(noreplace) %{_sysconfdir}/sysconfig/%{name}
%dir %{_prefix}/lib/immich
%{_prefix}/lib/immich/app
%{_prefix}/lib/immich/corePlugin
%{_prefix}/lib/immich/geodata
%{_prefix}/lib/immich/www
%dir %attr(0750,immich,immich) %{_sharedstatedir}/immich

