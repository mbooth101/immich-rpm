From c71431ae22cf19bc2d0518c101f732227eee135b Mon Sep 17 00:00:00 2001
From: Mat Booth <mat.booth@gmail.com>
Date: Wed, 21 Oct 2026 16:00:12 +0100
Subject: [PATCH 1/2] more robust scripts

---
 server/bin/start.sh | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/server/bin/start.sh b/server/bin/start.sh
index 15f4411..254b028 100755
--- a/server/bin/start.sh
+++ b/server/bin/start.sh
@@ -22,7 +22,8 @@ else
   echo "skipping libmimalloc - path not found $lib_path"
 fi
 export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/usr/lib/jellyfin-ffmpeg/lib"
-SERVER_HOME="$(readlink -f "$(dirname "$0")/..")"
+SCRIPT_LOC="$(readlink -f "$(dirname "$0")")"
+SERVER_HOME="$( (cd $SCRIPT_LOC/.. && pwd) )"
 
 read_file_and_export() {
 	fname="${!1}"
@@ -42,7 +43,7 @@ read_file_and_export "DB_USERNAME_FILE" "DB_USERNAME"
 read_file_and_export "DB_PASSWORD_FILE" "DB_PASSWORD"
 read_file_and_export "REDIS_PASSWORD_FILE" "REDIS_PASSWORD"
 
-if CPU_CORES="${CPU_CORES:=$(get-cpus.sh 2>/dev/null)}"; then
+if CPU_CORES="${CPU_CORES:=$($SCRIPT_LOC/get-cpus.sh 2>/dev/null)}"; then
   log_message "Detected CPU Cores: $CPU_CORES"
   if [ "$CPU_CORES" -gt 4 ]; then
     export UV_THREADPOOL_SIZE=$CPU_CORES
@@ -53,9 +54,9 @@ fi
 
 if [ -f "${SERVER_HOME}/dist/main.js" ]; then
   if [ "$QUIET" = "true" ]; then
-    exec node --no-warnings "${SERVER_HOME}/dist/main.js" "$@"
+    exec node-24 --no-warnings "${SERVER_HOME}/dist/main.js" "$@"
   else
-    exec node "${SERVER_HOME}/dist/main.js" "$@"
+    exec node-24 "${SERVER_HOME}/dist/main.js" "$@"
   fi
 else
   echo "Error: ${SERVER_HOME}/dist/main.js not found"
